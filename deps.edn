{:paths ["src"]
 :deps {io.github.kotoba-lang/org-signal
        {:git/url "https://github.com/kotoba-lang/org-signal.git"
         :git/sha "511e4b47de5d17945aa02815725703e8eb52bdef"}}
 :aliases {:test {:extra-paths ["test"]
                  :extra-deps {io.github.cognitect-labs/test-runner
                               {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                               ;; The tests -- not src -- read this repo's
                               ;; judgements from their owner rather than from
                               ;; copies: kotoba.security.crypto-policy decides
                               ;; whether the ML-KEM provider is qualified, and
                               ;; kotoba.security.key-status owns which key
                               ;; statuses may authorise new work. Declared as a
                               ;; git dep so the fleet gate's classpath walk
                               ;; finds it; src stays free of it.
                               io.github.kotoba-lang/security
                               {:git/url "https://github.com/kotoba-lang/security.git"
                                :git/sha "b4ff9d8a56263030bc92539b101e1eeb2dbfce39"}}
                  :main-opts ["-m" "cognitect.test-runner"]}}}
